; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes to [section] group in section root menu
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pawn Master"
config/description="Inspect. Decide. Profit. A pocket-sized pawn shop haggling game."
run/main_scene="res://scenes/game/game.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

CategoryDatabase="*res://autoload/category_database.gd"
ConditionDatabase="*res://autoload/condition_database.gd"
ItemDatabase="*res://autoload/item_database.gd"
ItemFactory="*res://autoload/item_factory.gd"
CustomerDatabase="*res://autoload/customer_database.gd"
ToolDatabase="*res://autoload/tool_database.gd"
PlayerProgress="*res://autoload/player_progress.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
